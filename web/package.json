{
  "name": "luke-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:icons": "node -e \"const si=require('simple-icons');const src=require('fs').readFileSync('src/data/icons.ts','utf8');const used=[...src.matchAll(/si[A-Z][a-z0-9]+/g)].map(m=>m[0]);const missing=used.filter(k=>!(k in si));missing.length?process.exit(console.error('MISSING:',missing)||1):console.log('icons OK')\""
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "framer-motion": "^13.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.3",
    "vite": "^5.4.8"
  }
}
